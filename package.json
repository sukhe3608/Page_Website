{
  "name": "novacore-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NovaCore Technologies — premium light-theme animated technology website (placeholder brand)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "crawl": true,
    "include": [
      "/thank-you",
      "/404"
    ],
    "removeBlobs": true,
    "skipThirdPartyRequests": true,
    "userAgent": "HeadlessChrome/120 react-snap",
    "timeout": 45000,
    "minifyHtml": {
      "collapseWhitespace": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "react-snap": "^1.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
